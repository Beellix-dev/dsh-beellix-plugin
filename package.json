{
  "name": "@beellix-ai/dsh-beellix-plugin",
  "version": "0.1.1",
  "beellixContract": {
    "schemaVersion": 1,
    "bridge": {
      "min": 1,
      "max": 1
    },
    "contributes": [
      "ui",
      "services"
    ],
    "data": {
      "schemaVersion": 1,
      "uninstall": "retain"
    }
  },
  "type": "module",
  "description": "dsh-BeelliX-plugin：Beelli X 品牌、场景导航与中台入口",
  "license": "MIT",
  "author": {
    "name": "BEELLIX",
    "url": "https://github.com/Beellix-dev"
  },
  "homepage": "https://github.com/Beellix-dev/dsh-beellix-plugin",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "beellix",
    "ui",
    "plugin-management"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./client": "./lib/client.js",
    "./platform": {
      "types": "./lib/platform-api.d.ts",
      "default": "./lib/platform-api.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./lib",
    "./cordis.patch.yml",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE",
    "./THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node dev/scripts/build-public.mjs",
    "test": "node dev/scripts/test-public.mjs",
    "check": "node dev/scripts/check-public.mjs",
    "prepack": "node dev/scripts/build-public.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "beellix": {
    "schemaVersion": 1,
    "ownership": "business",
    "kind": "plugin",
    "group": "ui",
    "contributes": [
      "ui",
      "services"
    ],
    "management": "configurable",
    "description": {
      "zh": "DSH 原生中台引导包与配套目录管理",
      "en": "DSH bootstrap and persistent directory management"
    },
    "displayName": {
      "zh": "dsh-BeelliX-plugin",
      "en": "dsh-BeelliX-plugin"
    }
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beellix-dev/dsh-beellix-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Beellix-dev/dsh-beellix-plugin/issues"
  },
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "ajv": "8.20.0",
    "clsx": "2.1.1",
    "immer": "10.2.0",
    "lightningcss": "1.33.0",
    "playwright": "1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "zustand": "4.4.7"
  }
}
