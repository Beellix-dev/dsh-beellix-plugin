{
  "name": "@beellix-ai/dsh-beellix-plugin",
  "version": "0.1.1",
  "beellixContract": {
    "schemaVersion": 1,
    "bridge": {
      "min": 1,
      "max": 1
    },
    "contributes": [
      "ui",
      "services"
    ],
    "data": {
      "schemaVersion": 1,
      "uninstall": "retain"
    }
  },
  "type": "module",
  "description": "Beelli X 社区中台：DSH 模型配置、插件管理与场景导航",
  "license": "MIT",
  "author": {
    "name": "BEELLIX",
    "url": "https://github.com/Beellix-dev"
  },
  "homepage": "https://github.com/Beellix-dev/dsh-beellix-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beellix-dev/dsh-beellix-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Beellix-dev/dsh-beellix-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "beellix",
    "ui",
    "plugin-management"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./client": "./lib/client.js",
    "./platform": {
      "types": "./lib/platform-api.d.ts",
      "default": "./lib/platform-api.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./lib",
    "./cordis.patch.yml",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE",
    "./THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node ../../../dev/scripts/build.mjs --only=community",
    "test": "node --test test/*.test.mjs",
    "prepack": "node ../../../dev/scripts/build.mjs --only=community"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "beellix": {
    "schemaVersion": 1,
    "ownership": "business",
    "kind": "plugin",
    "group": "ui",
    "contributes": [
      "ui",
      "services"
    ],
    "management": "configurable",
    "description": {
      "zh": "DSH 原生中台引导包与配套目录管理",
      "en": "DSH bootstrap and persistent directory management"
    },
    "displayName": {
      "zh": "dsh-BeelliX-plugin",
      "en": "dsh-BeelliX-plugin"
    }
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
